module top(
    input [3:0] a,
    input [3:0] b,
    input cin,
    output reg [3:0] sum,
    output reg cout
);
    // Write your code here
 

    reg [4:0] temp;

    always @(*) begin
        temp = a + b + cin;

        if (temp > 9) begin
            temp = temp + 6;
            cout = 1;
        end
        else
            cout = 0;

        sum = temp[3:0];
    end


    
endmodule
