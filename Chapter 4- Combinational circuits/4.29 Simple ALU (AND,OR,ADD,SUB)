module top(
    input [7:0] a,
    input [7:0] b,
    input [1:0] op,
    output reg [7:0] out
);
    // Write your code here
    always @(*)begin 
        case(op)
            2'b00:out=a & b;
            2'b01:out=a | b;
            2'b10:out=a + b;
            2'b11:out=a - b;
        endcase
    end
endmodule
